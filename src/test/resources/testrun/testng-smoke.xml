<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Sterna AMS Smoke Tests" verbose="2" parallel="none">

    <listeners>
        <listener class-name="listerners.TestListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>
    <parameter name="environment" value="qa"/>

    <!-- Smoke Tests - Quick validation of critical functionality -->
    <test name="Login Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="tests.LoginTest">
                <methods>
                    <include name="testLoginPageLoads"/>
                    <include name="testLoginPageElementsDisplayed"/>
                    <include name="testSuccessfulLogin"/>
                    <include name="testLoginWithInvalidCredentials"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
