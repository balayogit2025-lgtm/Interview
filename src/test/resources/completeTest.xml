<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Sterna AMS Automation Test Suite" parallel="tests" thread-count="5" verbose="1">

    <parameter name="browser" value="chrome"/>

    <listeners>
        <!-- Add TestNG listeners here if needed -->
    </listeners>

    <test name="Login Tests" preserve-order="true">
        <classes>
            <class name="TestRun.LoginTest"/>
        </classes>
    </test>

    <test name="Dashboard Tests" preserve-order="true">
        <classes>
            <class name="TestRun.DashboardTest"/>
        </classes>
    </test>

    <test name="Role Tests" preserve-order="true">
        <classes>
            <class name="TestRun.RoleTest"/>
        </classes>
    </test>

    <test name="User Tests" preserve-order="true">
        <classes>
            <class name="TestRun.UserTest"/>
        </classes>
    </test>

    <test name="Activity Tests" preserve-order="true">
        <classes>
            <class name="TestRun.ActivityTests"/>

        </classes>
    </test>

    <test name="Level Tests" preserve-order="true">
        <classes>
            <class name="TestRun.LevelTest"/>

        </classes>
    </test>
        <test name="Keybox Tests" preserve-order="true">
            <classes>
                <class name="TestRun.KeyboxTest"/>
            </classes>
        </test>

         <test name="Device Activity Report Tests" preserve-order="true">
             <classes>
                 <class name="TestRun.DeviceActivityTest"/>
              </classes>
           </test>
    <test name="Key Position Template Tests" preserve-order="true">
        <classes>
            <class name="TestRun.KeyPositionTemplateTest"/>
        </classes>
    </test>
</suite>
