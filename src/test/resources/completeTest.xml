<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Sterna AMS Automation Test Suite" parallel="false" thread-count="1" verbose="1">

    <parameter name="browser" value="chrome"/>

    <listeners>
        <!-- Add TestNG listeners here if needed -->
    </listeners>

    <test name="Login Tests" preserve-order="true">
        <classes>
            <class name="TestRun.LoginTest"/>
            <class name="TestRun.DashboardTest"/>
            <class name="TestRun.RoleTest"/>
            <class name="TestRun.UserTest"/>
        </classes>
    </test>

    <test name="Keybox Tests" preserve-order="true">
        <classes>
            <class name="TestRun.KeyboxTest"/>
        </classes>
    </test>

    <test name="Device Activity Report Tests" preserve-order="true">
        <classes>
            <class name="TestRun.DeviceActivityTest"/>
        </classes>
    </test>

</suite>
