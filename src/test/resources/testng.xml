<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Sterna AMS Automation Suite" verbose="2" parallel="none" thread-count="1">

    <!-- Test parameters -->
    <parameter name="browser" value="chrome"/>
    <parameter name="environment" value="qa"/>

    <!-- Login Module Tests -->
    <test name="Login Module Tests">
        <classes>
            <class name="TestRun.LoginTest"/>
        </classes>
    </test>

    <!-- Dashboard Module Tests -->
    <test name="Dashboard Module Tests">
        <classes>
            <class name="TestRun.DashboardTest"/>
        </classes>
    </test>

</suite>
